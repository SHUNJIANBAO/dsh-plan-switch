{
  "name": "dsh-plan-switch",
  "version": "1.0.0",
  "description": "常驻 Plan 模式开关按钮：在对话输入栏用更低 priority 影子替换官方 Plan 圆片，默认显示未开启，点击走 /plan 命令通道切换。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plan",
    "web-ui"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SHUNJIANBAO/dsh-plan-switch.git"
  },
  "scripts": {
    "test": "node test/offline-regression.mjs"
  }
}
